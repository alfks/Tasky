{
  "name": "tasky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && find dist/client -name AGENTS.md -delete && pnpm sw:build && node scripts/check-dist.mjs",
    "sw:build": "serwist build serwist.config.js",
    "start": "wrangler dev --config wrangler.jsonc",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry-run": "bash scripts/deploy.sh --dry-run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json && tsc -p tsconfig.worker.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:slow": "VITEST_SLOW=1 vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "bash scripts/check.sh",
    "check:arch": "bash scripts/check-arch.sh",
    "setup": "bash scripts/setup.sh",
    "wt": "bash scripts/wt.sh",
    "db:migrate:local": "wrangler d1 migrations apply tasky --local",
    "db:migrate:remote": "wrangler d1 migrations apply tasky --remote"
  },
  "dependencies": {
    "clsx": "^2",
    "dexie": "^4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "^6",
    "jsdom": "^26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.6",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
