{
  "name": "tasky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && rm -f dist/client/AGENTS.md && pnpm sw:build",
    "sw:build": "serwist build serwist.config.js",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:dry-run": "vinext-cloudflare deploy --config dist/server/wrangler.json --dry-run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "bash scripts/check.sh",
    "check:arch": "bash scripts/check-arch.sh",
    "setup": "bash scripts/setup.sh",
    "wt": "bash scripts/wt.sh"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.0.0-beta.8",
    "clsx": "^2",
    "dexie": "^4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "tailwind-merge": "^3",
    "vinext": "1.0.0-beta.10",
    "zustand": "^5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1",
    "@serwist/cli": "^9.5.12",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "15.x",
    "eslint-config-prettier": "^10",
    "fake-indexeddb": "^6",
    "jsdom": "^26",
    "next": "15.5.25",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "serwist": "^9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.131.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "workerd"
    ]
  }
}
