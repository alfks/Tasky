// 읽기 조건: Cloudflare Workers 배포 대상(이름·정적 자산 경로·바인딩)을 바꿀 때.
// 이 파일이 배포에 그대로 쓰인다 — 빌드가 wrangler 설정을 다시 만들지 않는다(ADR-0013).
// account_id 는 여기 적지 않는다 — CLOUDFLARE_ACCOUNT_ID 환경변수로 넘긴다(레포에 계정 ID 비커밋).
//
// **"main"(Worker 스크립트)이 T-93 에서 처음 붙었다** — 이전에는 SPA 정적 자산 배포뿐이었다.
// `run_worker_first: ["/api/*", "/auth/*"]` 가 그 두 경로만 Worker(`worker/index.ts`)로 먼저
// 보낸다 — 그 밖의 모든 요청은 `assets`(SPA 정적 자산)가 그대로 받는다. "main" 없이 이 키를
// 넣으면 `Cannot set run_worker_first without a Worker script.` 로 dry-run 이 실패한다(T-92 이전
// 실측 — 이제 "main" 이 있으니 그 제약이 풀린다).
//
// `tsconfig`: wrangler(esbuild)가 `@/*` 별칭을 해석하려면 필요하다(`wrangler deploy --help` 로
// `--tsconfig` 옵션이 있음을 확인했다 — jsonc 최상위 키로도 받는다, 이 커밋에서 dry-run 으로 실측).
//
// D1 마이그레이션: `migrations_dir` 가 `worker/db/migrations/`(0001_init.sql, 불가역 스키마)를
// 가리킨다 — `pnpm db:migrate:local`/`db:migrate:remote`(package.json)와 `scripts/deploy.sh`(실제
// 배포 직전)가 이 설정으로 `wrangler d1 migrations apply tasky` 를 돈다.
//
// d1_databases·vars 는 `--dry-run`(오프라인, 로컬 해석만)까지만 확인됐다 — 이 계정의 실제
// Cloudflare API 에 이 바인딩들을 태워 본 적은 아직 없다. CLOUDFLARE_API_TOKEN 에 D1 권한이
// 빠져 있는 등의 문제는 첫 실배포에서 처음 드러날 수 있다 — .env.example 의
// CLOUDFLARE_API_TOKEN 주석(D1:Edit 권한) 참고. **구글 OAuth 실왕복·실배포는 이 PR 에서
// 검증되지 않았다**(자격증명은 사용자 로컬에만 있다).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasky",
  "compatibility_date": "2026-09-15",
  "main": "worker/index.ts",
  "tsconfig": "tsconfig.worker.json",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasky",
      "database_id": "b5bcb45e-347a-4dcd-a0e1-12f5146f8b3c",
      "migrations_dir": "worker/db/migrations",
    },
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "GOOGLE_CLIENT_ID": "430669646782-29td1hskagbod68cr8k082hur51ph9gt.apps.googleusercontent.com",
    "SOCIAL_MODE": "off",
  },
}
