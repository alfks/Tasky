{
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["cn"],
  "overrides": [
    { "files": "*.md", "options": { "proseWrap": "preserve", "printWidth": 120 } },
    { "files": "*.{yml,yaml}", "options": { "singleQuote": false } }
  ]
}
