# 읽기 조건: 배포를 처음 설정할 때, 또는 배포가 자격증명 문제로 실패할 때.
#
# 사용법
#   cp .env.example .env    그리고 .env 의 빈 값을 채운다.
#   .env 는 .gitignore 에 있어 커밋되지 않는다. 이 파일(.env.example)만 커밋된다.
#   값을 채운 뒤: pnpm run deploy:dry-run  → 문제 없으면  pnpm run deploy
#
# 주의: 토큰을 이 파일(.env.example)에 적지 말 것. 여기는 커밋된다.

# ── Cloudflare ────────────────────────────────────────────────────────────────
# 1) CLOUDFLARE_ACCOUNT_ID
#    dash.cloudflare.com 에 로그인한 뒤 주소창에 보이는 32자리 16진수.
#    예: https://dash.cloudflare.com/1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d  ← 뒤쪽 32자리
CLOUDFLARE_ACCOUNT_ID=

# 2) CLOUDFLARE_API_TOKEN
#    우측 상단 프로필 → My Profile → API Tokens → Create Token
#    → "Edit Cloudflare Workers" 템플릿의 [Use template] → 생성된 토큰을 복사.
#    (Account 는 본인 계정, Zone 은 없어도 workers.dev 배포에 문제 없음)
CLOUDFLARE_API_TOKEN=

# 3) DEPLOY_URL (CI 스모크 확인용 — 로컬 배포에서는 쓰이지 않는다)
#    첫 배포가 끝나면 wrangler 가 출력하는 주소를 여기 적는다.
#    예: https://tasky.<본인-subdomain>.workers.dev
#    scripts/deploy.sh 는 이 값을 읽기만 하고 쓰지 않는다. 실제로 쓰는 곳은 CI 의 배포 확인 단계이고,
#    거기서는 레포 Variables 의 DEPLOY_URL 을 보며 **비어 있으면 워크플로가 실패한다**(.github/workflows/deploy.yml).
DEPLOY_URL=
