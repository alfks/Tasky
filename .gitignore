node_modules/
.pnpm-store/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- 테스트 산출물 ---
coverage/
playwright-report/
test-results/
blob-report/

# --- 환경 변수 ---
.env
.env.*
!.env.example

# --- PWA (Serwist가 빌드 시 생성) ---
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# --- 워크트리 + 로컬 협업 상태 (AGENTS.md만 트래킹) ---
.worktrees/*
!.worktrees/AGENTS.md

# --- 스크래치 / 임시 ---
tmp/
*.tmp
*.draft.md
*.scratch.*
.scratchpad/
*.orig
