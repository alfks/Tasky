# 읽기 조건: 무시 규칙을 바꿀 때만.

# --- 의존성 / 빌드 ---
node_modules/
.pnpm-store/
.wrangler/
out/
build/
dist/
*.tsbuildinfo

# --- 테스트 산출물 ---
coverage/
playwright-report/
test-results/
blob-report/

# --- 환경 변수 ---
.[eE][nN][vV]
.[eE][nN][vV].*
!.env.example
.dev.vars*
!.dev.vars.example

# --- PWA (serwist build 가 dist/client/sw.js 로 생성 — dist/ 가 이미 무시된다) ---

# --- 워크트리 + 로컬 협업 상태 (AGENTS.md만 트래킹) ---
.worktrees/*
!.worktrees/AGENTS.md

# --- 스크래치 / 임시 ---
tmp/
*.tmp
*.draft.md
*.scratch.*
.scratchpad/
*.orig
*.rej
__arch__/
*.bak

# --- OS ---
.DS_Store
._*
Thumbs.db
Desktop.ini

# --- 에디터 ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# --- 로그 ---
*.log
npm-debug.log*
pnpm-debug.log*
yarn-*.log

# --- 배포/도구 ---
.vercel
.turbo
.eslintcache
.claude/settings.local.json
